rules_version = '2';

// ============================================================================
// Firestore Security Rules — Pusat Alumni UPSI · KPI Dashboard
// ----------------------------------------------------------------------------
// Model:
//   • Public dashboard data (KPI quarters + Takwim) is world-readable so guests
//     can view it without signing in.
//   • Only the admin account (email below) may create/update/delete data.
//   • Audit logs are admin-only to read and append-only (never edited/deleted).
//
// All application data lives under:
//     artifacts/{appId}/public/data/
//         ├─ kpi-{year}/{q1..q4}      ← KPI dashboard
//         ├─ takwim-{year}/main       ← activity calendar
//         ├─ tugasan/{year}, staf     ← document tasks per programme (admin only)
//         ├─ aset, aset-bilik,        ← asset checking (aset accounts only)
//         │  aset-kitaran/{id}/semakan, aset-tetapan
//         └─ audit-logs/{autoId}      ← admin action trail
//
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
//         (or:  firebase deploy --only firestore:rules)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The admin accounts permitted to modify data (mirrors js/auth.js
    // ADMIN_EMAILS): the unit account and a second admin. Guests
    // authenticate anonymously (no email claim) and can never satisfy this.
    // A new address here must already exist in Firebase Authentication
    // BEFORE these rules are published, or anyone could sign up with it.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['alumni@upsi.edu.my', 'fahman@upsi.edu.my'];
    }

    // Accounts that run the asset check (tab Aset; mirrors js/auth.js
    // ASET_EMAILS). farhiah@ is an aset account only, NOT an admin: she can
    // read and write the aset collections and nothing else. As above, a new
    // address must already exist in Firebase Authentication before these
    // rules are published.
    function isAset() {
      return request.auth != null
        && request.auth.token.email in ['alumni@upsi.edu.my', 'fahman@upsi.edu.my', 'farhiah@upsi.edu.my'];
    }

    // A check record must carry one of the asset app's verification remarks
    // (js/aset.js ASET_STATUS), spelled exactly as in the UPSI app.
    function validSemakan() {
      return request.resource.data.status in [
        'ASET DALAM KEADAAN BAIK', 'ASET TIADA DI LOKASI', 'ASET ROSAK',
        'ASET DALAM PROSES PELUPUSAN', 'ASET SUDAH LUPUS',
        'ASET DALAM PROSES BAIK PULIH', 'LOKASI TIDAK DIKEMASKINI',
        'PEMILIK ASET TIDAK DIKEMASKINI', 'STICKER HILANG/TIADA',
        'STICKER PUDAR', 'LAIN-LAIN'
      ];
    }

    // Shape guard for the collections the dashboard renders: the list field the
    // client reads must exist and be a list. Every current writer already sends
    // it; meta / any other collection is exempt.
    function validShape(collection) {
      return kpiShape(collection) && takwimShape(collection);
    }

    // Collections that are never public; each has its own rule below.
    function isPrivate(collection) {
      return collection == 'audit-logs' || collection == 'tugasan'
        || collection.matches('aset(-[a-z]+)?');
    }

    function kpiShape(collection) {
      return !collection.matches('kpi-[0-9]{4}')
        || (request.resource.data.keys().hasAll(['kpis'])
            && request.resource.data.kpis is list);
    }

    function takwimShape(collection) {
      return !collection.matches('takwim-[0-9]{4}')
        || (request.resource.data.keys().hasAll(['events'])
            && request.resource.data.events is list);
    }

    match /artifacts/{appId}/public/data {

      // ----- Audit trail: admin-only, append-only ------------------------
      match /audit-logs/{logId} {
        allow read:   if isAdmin();
        allow create: if isAdmin()
                      && request.resource.data.action is string
                      && request.resource.data.user == request.auth.token.email
                      && request.resource.data.timestamp == request.time;
        allow update, delete: if false;   // immutable once written
      }

      // ----- Programme document tasks: admin only (read AND write) ------
      // Staff names, emails, due dates and Drive links are internal, so this
      // collection is NOT public like the dashboard data. The app checks that
      // this rule is live (a guest read must be refused) before it saves.
      match /tugasan/{docId} {
        allow read, write: if isAdmin();
      }

      // ----- Asset check: aset accounts only (read AND write) ---------
      // Staff names and asset lists are internal. The app checks that these
      // rules are live (a guest read must be refused) before it imports data
      // or opens a check cycle.
      match /aset/{docId} {
        allow read, write: if isAset();
      }
      match /aset-bilik/{docId} {
        allow read, write: if isAset();
      }
      match /aset-tetapan/{docId} {
        allow read, write: if isAset();
      }
      match /aset-kitaran/{kitaranId} {
        allow read, write: if isAset();
        match /semakan/{docId} {
          allow read, delete: if isAset();
          allow create, update: if isAset() && validSemakan();
        }
      }

      // ----- KPI (kpi-YYYY), Takwim (takwim-YYYY) & any other public -----
      // collection: anyone may read; only the admin may write.
      // (audit-logs, tugasan and the aset collections are excluded here: each is governed solely by
      // its own rule above.)
      match /{collection}/{docId} {
        allow read:  if !isPrivate(collection);
        allow write: if isAdmin() && !isPrivate(collection)
                     && validShape(collection);

        // Defensive: same policy for any nested subcollections.
        match /{sub=**} {
          allow read:  if !isPrivate(collection);
          allow write: if isAdmin() && !isPrivate(collection);
        }
      }
    }

    // Anything outside artifacts/{appId}/public/data is denied by default
    // (Firestore denies any path with no matching allow).
  }
}
